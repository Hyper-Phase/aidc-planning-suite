{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{index.html,core/**,reference/**}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index?endpoint=panel"
    },
    {
      "source": "/index.html",
      "destination": "/api/index?endpoint=panel"
    },
    {
      "source": "/api/models",
      "destination": "/api/index?endpoint=models"
    },
    {
      "source": "/api/plan",
      "destination": "/api/index?endpoint=plan"
    }
  ]
}
